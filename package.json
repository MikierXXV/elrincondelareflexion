{
  "name": "elrincondelareflexion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Recorrido interactivo por la historia de la filosofía, organizado por ideas.",
  "scripts": {
    "dev": "npm run generar && vite",
    "build": "npm run validar && npm run generar && tsc --noEmit && vite build",
    "generar": "node scripts/generar-indices.mjs && node scripts/generar-html.mjs",
    "indices": "node scripts/generar-indices.mjs",
    "preview": "vite preview",
    "validar": "node scripts/validate-content.mjs --completo && node scripts/check-contraste.mjs",
    "validar:fuentes": "node scripts/check-fuentes.mjs",
    "capturar": "node scripts/capturar-prototipos.mjs",
    "capturar:galeria": "node scripts/capturar-galeria.mjs",
    "probar:mecanicas": "node scripts/capturar-detalle.mjs",
    "revisar:piezas": "node scripts/check-piezas.mjs",
    "capturar:sitio": "node scripts/capturar-sitio.mjs",
    "auditar": "node scripts/auditar.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^3.10.1",
    "@gltf-transform/extensions": "^3.10.1",
    "@gltf-transform/functions": "^3.10.1",
    "@types/node": "^26.1.2",
    "@types/three": "^0.169.0",
    "meshoptimizer": "^0.20.0",
    "playwright": "^1.62.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "three": "^0.169.0"
  }
}
